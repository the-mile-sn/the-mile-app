FROM postgres:18-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv && rm -rf /var/lib/apt/lists/*
WORKDIR /srv/admin
COPY . .
RUN python3 -m venv /opt/validation && /opt/validation/bin/pip install --no-cache-dir -r requirements.txt -r validation_player/requirements.txt
ENV PATH="/opt/validation/bin:$PATH"
ENTRYPOINT ["/bin/sh","/srv/admin/run_visual_validation.sh"]
